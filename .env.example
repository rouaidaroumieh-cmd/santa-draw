# PostgreSQL connection string (local Docker, Neon, Supabase...)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Organiser password: needed to run the daily draw and to use the Admin page.
# It also signs the login cookie, so changing it logs everyone out.
ADMIN_PASSWORD=change-me

# Optional separate secret for Fun Lab PINs (stable 4-digit PIN per person).
# If omitted, ADMIN_PASSWORD is used. Changing it changes every PIN.
# FUN_LAB_PIN_SECRET=another-long-secret

# Time zone used to decide which day it is (IANA name). Defaults to UTC.
# CAMPAIGN_TIMEZONE=Europe/Paris
